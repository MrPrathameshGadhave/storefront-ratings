# Runtime
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Set to true only behind a trusted reverse proxy that replaces client IP headers.
TRUST_PROXY=false

# Database
# Use a local database name appropriate to your machine; do not commit a real hosted URL.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/storefront_ratings?schema=public"

# Session authentication
# Replace with a long, random secret. Never reuse this development placeholder in production.
JWT_SECRET=replace-with-a-long-random-secret-at-least-32-characters
JWT_EXPIRES_IN=8h

# Email / local MailHog defaults
# MailHog normally listens on SMTP port 1025 and exposes its inbox at http://localhost:8025.
SMTP_HOST=localhost
SMTP_PORT=1025
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Storefront Ratings <no-reply@storefront-ratings.local>"

# Optional first-Administrator bootstrap (production only).
# Leave all three unset for routine local development. On a brand-new deployment
# with no ADMIN account, set all three server-only values, use the matching
# confidential /register/admin/<token> URL once, then remove all three values.
# ADMIN_BOOTSTRAP_TOKEN=
# ADMIN_BOOTSTRAP_CODE=
# Required ISO-8601 deadline when bootstrap is enabled, for example 2026-12-31T23:59:59Z.
# ADMIN_BOOTSTRAP_EXPIRES_AT=
